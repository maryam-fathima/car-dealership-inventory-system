// GET CURRENT USER
export function getCurrentUser(): User | null {
  const t = token();

  if (!t) {
    return null;
  }

  try {
    return JSON.parse(
      atob(t.split(".")[1])
    ) as User;
  } catch {
    return null;
  }
}


// LOGOUT
export function logout() {
  localStorage.removeItem("access_token");
}
